# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).
# These are EXPO_PUBLIC_* on purpose — Expo inlines them into the client bundle,
# and Supabase's anon key is safe to ship client-side (RLS policies do the real access control).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
